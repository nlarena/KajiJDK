# Rust build output
/target

# Class corpus extracted from the JDK for differential testing (not committed)
/corpus/
/.corpus_tmp/

# float/double differential battery (generated from real Java)
/.float_battery.txt
/.jdk25_tmp/

# Herramientas congeladas (`bin/*.exe`): NO se commitean — son ~48 MB y los `.exe` no
# deltifican, así que cada refresco duplicaría el peso del historial. Se reconstruyen desde
# un commit con la receta de `bin/FROZEN.md`, que sí viaja con el repo justamente para que
# el snapshot sea reproducible sin cargar los binarios.
/bin/*
!/bin/FROZEN.md

# Stray artifacts (not part of the project)
/out.txt
/bootout/
